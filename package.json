{
  "name": "duet",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "node scripts/generate-icons.mjs && vite build",
    "start": "node server/index.js",
    "share": "node scripts/share.mjs",
    "test": "node --test server/lib/parseLocal.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "slides": "node scripts/make-presentation.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/finalize-pptx.ps1",
    "report:pdf": "node scripts/make-report-pdf.mjs",
    "pitch": "node scripts/make-pitch.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/finalize-pitch.ps1",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "npm run build && node scripts/copy-android-icons.mjs && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@vitejs/plugin-react": "^4.3.4",
    "cloudflared": "^0.7.3",
    "concurrently": "^9.1.2",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
