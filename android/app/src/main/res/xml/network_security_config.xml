<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP so the emulator can reach the host API at 10.0.2.2 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
